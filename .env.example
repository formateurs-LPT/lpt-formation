# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais committer .env.local (déjà dans .gitignore).
# Après modification : arrêter npm run dev (Ctrl+C) puis relancer.

# Supabase — projet Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon

# Code session formation
NEXT_PUBLIC_SESSION_CODE=LPT2026

# Codes formateur (les deux formats peuvent coexister)
NEXT_PUBLIC_TRAINER_CODE_KEVIN=3442
NEXT_PUBLIC_TRAINER_CODE_QUENTIN=3930
NEXT_PUBLIC_TRAINER_CODE_NADEGE=8281
NEXT_PUBLIC_TRAINER_AUTH_JSON={"kevin":"3442","quentin":"3930","nadege":"8281","nadège":"8281"}
